// FEC Database — Schema v1.2  (generated from live DB)
// Paste into the dbdiagram.io EDITOR pane (not SQL import).
// Regenerate: env\Scripts\python.exe docs/build_dbml.py

Table occupation_categories {  // 30 rows
  occupation_category_id int [pk]
  name text [unique, not null]
  Note: '''Lookup: ~29 standardized occupation buckets. LAWYER vs ATTORNEY stay distinct as raw occupations; this groups them for filtering.'''
}

Table committees {  // 5 rows
  committee_id int [pk, note: '''Surrogate integer PK. The real FEC identifier is committee_number.''']
  committee_number text [unique]
  committee_name text [not null]
  committee_short text
  raised decimal
  spent decimal
  irs_990_link text
  logo_path text
  Note: '''FEC-registered committees + related orgs (AIPAC, ZOA, â€¦). committee_number is the FEC id; committee_id is a surrogate PK.'''
}

Table donors {  // 18,671 rows
  donor_id int [pk]
  donor_key text [unique, not null, note: '''Stable identity hash from donor_match â€” used in public URLs (/donor/<key>) and survives DB reloads.''']
  entity_type text [not null]
  first_name text
  last_name text
  Note: '''Unique donors (individuals + contributing orgs). One row per donor_key identity hash. No denormalized "latest" pointers â€” derived via views.'''
}

Table addresses {  // 24,949 rows
  address_id int [pk]
  street_1 text
  street_2 text
  city text
  state_code text
  zip_code text
  latitude double
  longitude double
  Note: '''Shared address dimension â€” one source of truth for every physical address. A donor residence and an employer HQ both point here, geocoded once.'''
}

Table employers {  // 10,523 rows
  employer_id int [pk]
  name text [unique, not null]
  address_id int
  Note: '''Unique companies. Corporate HQ lives in addresses via address_id (NULL when the lookup could not resolve a small private firm).'''
}

Table donor_addresses {  // 22,052 rows
  donor_address_id int [pk]
  donor_id int [not null]
  address_id int [not null]
  Note: '''Link: donor â†” address. The "when" (first/last donation here) is NOT stored â€” it is derived from contributions (MIN/MAX receipt_date).'''
}

Table donor_employments {  // 23,924 rows
  donor_employment_id int [pk]
  donor_id int [not null]
  employer_id int
  occupation text
  occupation_category_id int
  employer_status text [note: '''One of: active / retired / self_employed / not_employed / committee / missing.''']
  previous_employer_id int [note: '''References employers.employer_id â€” the donor's PRIOR employer (e.g. "Retired آ· previously at X"). It is an EMPLOYER, not a previous donor_employments row.''']
  indexes {
    (donor_id, employer_id, occupation) [unique]
  }
  Note: '''Link: each distinct (donor, employer, occupation). employer_id is NULL for retired / self-employed / not-employed / committee donors.'''
}

Table contributions {  // 198,822 rows
  sub_id bigint [pk, note: '''FEC's own numeric filing id (the natural key) â€” kept as the PK name on purpose, NOT a surrogate "id".''']
  transaction_id text [not null]
  donor_id int [not null]
  committee_id int [not null]
  donor_address_id int
  donor_employment_id int
  amount decimal [not null]
  receipt_date date [not null]
  election_cycle int [not null]
  Note: '''Fact table â€” one row per FEC filing. Foreign keys only, no denormalized copies. The largest table.'''
}

Table leaders {  // 86 rows
  leader_id int [pk]
  donor_id int [unique, not null]
  Note: '''Curated roster of org leadership (AIPAC / DMFI / â€¦). Identity from donor_id â†’ donors; committee memberships in leader_committees. NOT derived from FEC data.'''
}

Table leader_committees {  // 91 rows
  leader_id int [pk]
  committee_id int [pk]
  Note: '''Junction (M:N): which committees each leader sits on. Composite PK (leader_id, committee_id); both FKs enforced.'''
}

Table key_accomplices {  // 80 rows
  accomplice_id int [pk]
  donor_id int [unique, not null]
  sign text [note: '''Deck-of-cards id for the landing-page visualization (e.g. "Ace Spades", "Joker"). Nullable.''']
  subtitle text
  body_text text
  image_path text
  committee_id int
  display_order int [not null, note: '''Curator-defined card ordering from the source CSV.''']
  Note: '''Curated editorial content for the dashboard cards (sign/subtitle/body/image/order). Identity comes from donor_id â†’ donors; NOT derived from FEC data.'''
}

Table us_states {  // 51 rows
  state_fips text [pk]
  code text [unique, not null]
  name text [not null]
  Note: '''Reference: FIPS â†” USPS code â†” name. Standalone â€” no FK to the core schema.'''
}

Table zcta_state_rel {  // 32,989 rows
  zcta5 text [pk]
  state_fips text [not null]
  Note: '''Reference: ZCTA (zip) â†’ state FIPS. Standalone â€” no FK to the core schema.'''
}

Table zip_centroids {  // 33,791 rows
  zip text [pk]
  lat double [not null]
  lng double [not null]
  source text [not null]
  fetched_at timestamp with time zone
  Note: '''Reference: zip â†’ lat/lng centroid (geocoding fallback). Standalone â€” no FK to the core schema.'''
}

// ── Foreign keys (real, enforced) ──
Ref: contributions.committee_id > committees.committee_id
Ref: contributions.donor_address_id > donor_addresses.donor_address_id
Ref: contributions.donor_employment_id > donor_employments.donor_employment_id
Ref: contributions.donor_id > donors.donor_id
Ref: donor_addresses.address_id > addresses.address_id
Ref: donor_addresses.donor_id > donors.donor_id
Ref: donor_employments.donor_id > donors.donor_id
Ref: donor_employments.employer_id > employers.employer_id
Ref: donor_employments.occupation_category_id > occupation_categories.occupation_category_id
Ref: donor_employments.previous_employer_id > employers.employer_id
Ref: employers.address_id > addresses.address_id
Ref: key_accomplices.committee_id > committees.committee_id
Ref: key_accomplices.donor_id > donors.donor_id
Ref: leader_committees.committee_id > committees.committee_id
Ref: leader_committees.leader_id > leaders.leader_id
Ref: leaders.donor_id > donors.donor_id
Ref: zcta_state_rel.state_fips > us_states.state_fips

// Note: leader↔committee is a real M:N via the leader_committees junction.