# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  FEC Pipeline — Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
#  Copy this file to .env and fill in your values:
#     cp .env.example .env
#
#  clean.py needs NO env vars (donor matching runs inside it).
#  resolve.py needs AI_PROVIDER plus the matching API key.
#  loader.py needs PG_* variables.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── AI employer-address lookup (for resolve.py) ──
# AI_PROVIDER picks the backend: openai (uses OPENAI_API_KEY)
# or xai (uses XAI_API_KEY).
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# XAI_API_KEY=xai-your-key-here

# ── PostgreSQL (for loader.py) ──
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=fec_db
PG_USER=fec_owner
PG_PASSWORD=your_password_here

# ── Database roles (optional — for multi-user setup) ──
# DB_ROLES=fec_owner,fec_app,ytpub001
# DB_ROLE_PASSWORD=shared_password_here

# ── FEC API (for pull.py, and clean.py's FEC address recovery) ──
# FEC_API_KEY=your-fec-api-key
