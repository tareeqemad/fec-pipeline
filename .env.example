# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  FEC Pipeline — Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
#  Copy this file to .env and fill in your values:
#     cp .env.example .env
#
#  Steps 1-2 (clean.py, donor_match.py) need NO env vars.
#  Step 3 (resolve.py) needs OPENAI_API_KEY.
#  Step 5 (loader.py) needs PG_* variables.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── OpenAI (for resolve.py — employer address lookup) ──
OPENAI_API_KEY=sk-your-key-here

# ── PostgreSQL (for loader.py) ──
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=fec_db
PG_USER=fec_owner
PG_PASSWORD=your_password_here

# ── Database roles (optional — for multi-user setup) ──
# DB_ROLES=fec_owner,fec_app,ytpub001
# DB_ROLE_PASSWORD=shared_password_here

# ── FEC API (for fec_pull.py — pulling new data) ──
# FEC_API_KEY=your-fec-api-key
